# Milestone 1 needs NO keys. These are listed so the env is ready as milestones land.
# All keyed calls go through /api serverless functions. Never prefix these with VITE_.
FINNHUB_API_KEY=            # M2 quotes + company news
TWELVEDATA_API_KEY=         # M2 intraday/daily candles
ALPHAVANTAGE_API_KEY=       # M2 fallback candles, fundamentals, earnings
FRED_API_KEY=               # M5 macro (rates, CPI, jobs)
SUPABASE_URL=               # M3 watchlists/playbooks, M4 journal
SUPABASE_SERVICE_ROLE_KEY=  # server-side only
VITE_SUPABASE_URL=          # public, safe in browser
VITE_SUPABASE_ANON_KEY=     # public anon key, row-level security required
ANTHROPIC_API_KEY=          # M10 AI layer, server-side only
