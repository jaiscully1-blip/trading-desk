# Without TWELVEDATA_API_KEY or FINNHUB_API_KEY the desk runs on DEMO DATA (badged).
# All are free tiers. Sign up: twelvedata.com, finnhub.io, alphavantage.co, fred.stlouisfed.org
# All keyed calls go through /api serverless functions. Never prefix these with VITE_.
FINNHUB_API_KEY=            # M2 real-time quotes (60 calls/min free). Company news in M5
TWELVEDATA_API_KEY=         # M2 candles D/1H/5m (8 credits/min, 800/day free)
ALPHAVANTAGE_API_KEY=       # M2 fallback daily candles (25 requests/day free). Fundamentals later
FRED_API_KEY=               # M2 VIX + 10Y in the top strip (end of day). More macro in M5
SEC_USER_AGENT=              # Company page: 'TradingDesk you@email.com' (SEC asks automated tools for a contact; not a key)
GEMINI_API_KEY=              # Company page: free key from aistudio.google.com; reads each 10-K once (cached)
AISSTREAM_API_KEY=           # World map shipping layer: free key from aisstream.io (optional; ship positions near oil chokepoints)
GEMINI_MODEL=                # optional override, default gemini-3.1-flash-lite
VITE_SUPABASE_URL=          # M3 optional sync; public, safe in browser
VITE_SUPABASE_ANON_KEY=     # public anon key; run supabase/schema.sql for row-level security
ANTHROPIC_API_KEY=          # M10 AI layer, server-side only
DESK_PASSWORD=              # unlocks private panels on the public desk
WEBULL_APP_KEY=             # Webull OpenAPI, read-only use
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=        # only if Webull's 2-step token is required
WEBULL_ACCOUNT_ID=          # optional
DISCORD_BOT_TOKEN=          # reads your 3 trading channels
